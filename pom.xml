<?xml version="1.0" encoding="UTF-8"?>
<!--
    Proyecto : Homecenter Envíos - Sistema de realización y seguimiento de pedidos
    Autores  : Juan Luis Torres Leal y Angela María Constain Escobar
    Programa : SENA - Análisis y Desarrollo de Software (3186607)

    Arquitectura:
      - Backend : Java 17 + Servlets/JSP (javax.servlet 3.1) + Hibernate ORM 7 (JPA) + MySQL
      - Frontend: React 19 + JSX compilado con Vite (carpeta /frontend), servido desde /app
    Empaquetado: WAR desplegable en Apache Tomcat 8.5 (XAMPP) o Tomcat 9.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>co.homecenter</groupId>
    <artifactId>homecenter-envios</artifactId>
    <version>2.0.0</version>
    <packaging>war</packaging>

    <name>Homecenter Envíos</name>
    <description>Aplicación web para la gestión de pedidos, envíos e incidencias de Homecenter.</description>

    <developers>
        <developer>
            <name>Juan Luis Torres Leal</name>
            <roles><role>Desarrollador</role></roles>
        </developer>
        <developer>
            <name>Angela María Constain Escobar</name>
            <roles><role>Desarrolladora</role></roles>
        </developer>
    </developers>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Hibernate 7 exige Java 17 como mínimo; Tomcat corre con JDK 17, 21, 24 o 25 -->
        <maven.compiler.release>17</maven.compiler.release>

        <!-- Versiones centralizadas para actualizarlas en un solo lugar -->
        <version.hibernate>7.4.12.Final</version.hibernate>
        <version.jackson>2.22.3</version.jackson>
    </properties>

    <dependencies>
        <!--
            API de Servlets: la provee el contenedor (Tomcat), por eso el alcance es "provided".
            Se usa la versión 3.1 porque es la que implementa Tomcat 8.5 (XAMPP);
            el mismo WAR funciona sin cambios en Tomcat 9 (Servlet 4.0).
        -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>javax.servlet-api</artifactId>
            <version>3.1.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- API de JSP: también la provee el contenedor -->
        <dependency>
            <groupId>javax.servlet.jsp</groupId>
            <artifactId>javax.servlet.jsp-api</artifactId>
            <version>2.3.3</version>
            <scope>provided</scope>
        </dependency>

        <!-- JSTL: etiquetas c:, fmt: y fn: usadas en las vistas JSP -->
        <dependency>
            <groupId>javax.servlet</groupId>
            <artifactId>jstl</artifactId>
            <version>1.2</version>
        </dependency>

        <!--
            Hibernate ORM: implementación de JPA (Jakarta Persistence 3.2).
            Convierte las clases del paquete "modelo" en tablas y genera el SQL.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${version.hibernate}</version>
        </dependency>

        <!-- Integración de Hibernate con HikariCP, el pool de conexiones más usado en Java -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-hikaricp</artifactId>
            <version>${version.hibernate}</version>
        </dependency>

        <!-- Controlador JDBC oficial de MySQL (Hibernate lo usa por debajo) -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>8.4.0</version>
            <exclusions>
                <!-- Protobuf solo lo usa la X DevAPI de MySQL, que este proyecto no necesita -->
                <exclusion>
                    <groupId>com.google.protobuf</groupId>
                    <artifactId>protobuf-java</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Envía los mensajes de HikariCP (que usa SLF4J) al registro estándar de Tomcat -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-jdk14</artifactId>
            <version>2.0.17</version>
        </dependency>

        <!-- Jackson: convierte objetos Java a JSON para la API que consume React -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${version.jackson}</version>
        </dependency>

        <!-- Soporte de Jackson para LocalDate y LocalDateTime (fechas ISO, p. ej. "2026-09-20") -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${version.jackson}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>homecenter-envios</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
        </plugins>
    </build>
</project>
