<?xml version="1.0" encoding="UTF-8"?>
<!--
    Descriptor de despliegue de Homecenter Envíos (Servlet 3.1, Tomcat 8.5+).
    Autores: Juan Luis Torres Leal y Angela María Constain Escobar
    Los servlets se registran con la anotación @WebServlet; aquí se declaran
    los filtros, porque su ORDEN de ejecución importa y las anotaciones no
    permiten definirlo.
-->
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Homecenter Envíos</display-name>

    <!-- 1. Codificación UTF-8: debe ejecutarse antes de leer cualquier parámetro -->
    <filter>
        <filter-name>CodificacionFiltro</filter-name>
        <filter-class>co.homecenter.envios.filtro.CodificacionFiltro</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CodificacionFiltro</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 2. Protección CSRF para todos los formularios POST -->
    <filter>
        <filter-name>CsrfFiltro</filter-name>
        <filter-class>co.homecenter.envios.filtro.CsrfFiltro</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CsrfFiltro</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- 3. Autenticación y autorización por rol -->
    <filter>
        <filter-name>AutenticacionFiltro</filter-name>
        <filter-class>co.homecenter.envios.filtro.AutenticacionFiltro</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AutenticacionFiltro</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <!-- La cookie de sesión no es accesible desde JavaScript -->
            <http-only>true</http-only>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Todas las páginas y fragmentos JSP se leen en UTF-8 (tildes y eñes) -->
    <jsp-config>
        <jsp-property-group>
            <url-pattern>*.jsp</url-pattern>
            <url-pattern>*.jspf</url-pattern>
            <page-encoding>UTF-8</page-encoding>
            <trim-directive-whitespaces>true</trim-directive-whitespaces>
        </jsp-property-group>
    </jsp-config>

    <!--
        index.jsp: raíz de la aplicación (redirige a la versión JSP).
        index.html: página de la aplicación React publicada en /app/.
    -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- Páginas de error amigables -->
    <error-page>
        <error-code>403</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/vistas/error.jsp</location>
    </error-page>
</web-app>
